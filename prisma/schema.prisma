// SplitSmart — Production Database Schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  GROUP_ADMIN
  TEAM_ADMIN
  SUPER_ADMIN
}

enum PlanType {
  FREE
  PRO
  TEAM
}

enum PlanStatus {
  ACTIVE
  TRIAL
  GRACE
  CANCELLED
  EXPIRED
}

enum GroupCategory {
  FLATMATES
  TRAVEL
  FRIENDS
  COUPLE
  FAMILY
  TEAM
  SUBSCRIPTIONS
  OTHER
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum SplitType {
  EQUAL
  PERCENTAGE
  CUSTOM
  SHARES
}

enum ExpenseCategory {
  RENT
  FOOD
  TRANSPORT
  UTILITIES
  ENTERTAINMENT
  SUBSCRIPTIONS
  TRAVEL
  SHOPPING
  HEALTH
  EDUCATION
  OTHER
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DISPUTED
  PARTIAL
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  CASH
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  MANUAL
}

enum PaymentState {
  CREATED
  ATTEMPTED
  SUCCESS
  FAILED
  ABANDONED
  REFUNDED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskEventType {
  SUSPICIOUS_LOGIN
  IMPOSSIBLE_TRAVEL
  SESSION_ANOMALY
  BRUTE_FORCE
  IP_REPUTATION_BLOCK
  PAYMENT_ABUSE
  REFUND_ABUSE
  DISPOSABLE_EMAIL
  API_ABUSE
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum ApiKeyScope {
  READ
  WRITE
  BILLING
  ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  FINANCE
  MEMBER
  VIEWER
}

enum CompliancePolicyType {
  TERMS
  PRIVACY
  REFUND
  COOKIE
  DPA
}

enum NotificationType {
  PAYMENT_DUE
  PAYMENT_RECEIVED
  EXPENSE_ADDED
  GROUP_INVITE
  SETTLEMENT_REQUEST
  SUBSCRIPTION_RENEWAL
  BADGE_EARNED
  STREAK_MILESTONE
  PLAN_EXPIRING
  FRAUD_ALERT
  GENERAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  PUSH
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum SubscriptionCategory {
  STREAMING
  MUSIC
  PRODUCTIVITY
  CLOUD
  GAMING
  OTHER
}

enum BillingCycle {
  MONTHLY
  YEARLY
  WEEKLY
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_DELETED
  GROUP_ARCHIVED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_CREATED
  SETTLEMENT_UPDATED
  SETTLEMENT_COMPLETED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_DELETED
  PAYMENT_INITIATED
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  PLAN_UPGRADED
  PLAN_CANCELLED
  ADMIN_IMPERSONATION
  ADMIN_USER_UPDATE
  FRAUD_FLAGGED
  FRAUD_FLAG
  GDPR_EXPORT
  ACCOUNT_DELETED
}

// ─── Auth (NextAuth v5) ────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  phone             String?   @unique
  passwordHash      String?
  role              UserRole  @default(USER)

  // Profile
  avatarUrl         String?
  currency          String    @default("INR")
  timezone          String    @default("Asia/Kolkata")
  language          String    @default("en")

  // Plan
  plan              PlanType   @default(FREE)
  planStatus        PlanStatus @default(ACTIVE)
  planStartedAt     DateTime?
  planExpiresAt     DateTime?
  trialEndsAt       DateTime?
  graceEndsAt       DateTime?
  cancelEffectiveAt DateTime?
  stripeCustomerId  String?    @unique
  razorpayContactId String?    @unique

  // Gamification
  reputationScore   Int     @default(0)
  paymentStreak     Int     @default(0)
  longestStreak     Int     @default(0)
  lastPaymentAt     DateTime?
  totalPaid         Float   @default(0)
  totalOwed         Float   @default(0)

  // Referral
  referralCode      String?    @unique @default(cuid())

  // Consent & compliance
  marketingConsent  Boolean  @default(false)
  whatsappConsent   Boolean  @default(false)
  emailVerifiedRequired Boolean @default(true)
  mfaEnabled        Boolean  @default(false)
  totpSecretHash    String?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  lastLoginCountry  String?
  gdprDeletedAt     DateTime?
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  groupMemberships  GroupMember[]
  createdGroups     Group[]
  createdExpenses   Expense[]      @relation("ExpenseCreator")
  expenseSplits     ExpenseSplit[]
  paidExpenses      Expense[]      @relation("ExpensePayer")
  fromSettlements   Settlement[]   @relation("SettlementFrom")
  toSettlements     Settlement[]   @relation("SettlementTo")
  notifications     Notification[]
  userBadges        UserBadge[]
  auditLogs         AuditLog[]
  invoices          Invoice[]
  payments          Payment[]
  otpCodes          OtpCode[]
  subscriptions     Subscription[]
  passwordResetTokens PasswordResetToken[]
  revokedSessions   RevokedSession[]
  impersonationSessions ImpersonationSession[] @relation("ImpersonatedUser")
  supportSessions   ImpersonationSession[] @relation("SupportAdmin")
  devices           UserDevice[]
  riskEvents        RiskEvent[]
  recoveryCodes     RecoveryCode[]
  apiKeys           ApiKey[]
  customerWebhooks  CustomerWebhook[]
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces   Workspace[] @relation("WorkspaceOwner")
  complianceAcceptances ComplianceAcceptance[]
  usageEvents       UsageEvent[]

  @@index([email])
  @@index([phone])
  @@index([plan])
  @@index([planStatus])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([reputationScore])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RevokedSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  reason    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model UserDevice {
  id             String   @id @default(cuid())
  userId         String
  fingerprintHash String
  label          String?
  userAgent      String?
  ipAddress      String?
  country        String?
  lastSeenAt     DateTime @default(now())
  trustedAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId])
  @@index([lastSeenAt])
  @@index([revokedAt])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([usedAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([expiresAt])
}

// ─── Groups ────────────────────────────────────────────────────────────────────

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  category    GroupCategory @default(OTHER)
  imageUrl    String?
  inviteCode  String        @unique @default(cuid())
  isArchived  Boolean       @default(false)
  currency    String        @default("INR")
  totalSpent  Float         @default(0)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy     User           @relation(fields: [createdById], references: [id])
  members       GroupMember[]
  expenses      Expense[]
  settlements   Settlement[]
  subscriptions GroupSubscription[]

  @@index([createdById])
  @@index([inviteCode])
  @@index([isArchived])
  @@index([createdAt])
}

model Workspace {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  ownerId         String
  plan            PlanType @default(FREE)
  seatLimit       Int      @default(5)
  billingEmail    String?
  stripeCustomerId String? @unique
  razorpayContactId String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members         WorkspaceMember[]

  @@index([ownerId])
  @@index([plan])
  @@index([createdAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  removedAt   DateTime?

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([role])
}

model GroupMember {
  id        String     @id @default(cuid())
  groupId   String
  userId    String
  role      MemberRole @default(MEMBER)
  balance   Float      @default(0)
  joinedAt  DateTime   @default(now())
  removedAt DateTime?
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// ─── Expenses ─────────────────────────────────────────────────────────────────

model Expense {
  id                String            @id @default(cuid())
  groupId           String
  title             String
  amount            Float
  currency          String            @default("INR")
  category          ExpenseCategory   @default(OTHER)
  splitType         SplitType         @default(EQUAL)
  paidById          String
  createdById       String
  receiptUrl        String?
  receiptOcrData    Json?
  notes             String?
  tags              String[]
  isRecurring       Boolean           @default(false)
  recurringInterval RecurringInterval?
  nextDueDate       DateTime?
  parentExpenseId   String?
  isDeleted         Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy        User           @relation("ExpensePayer", fields: [paidById], references: [id])
  createdBy     User           @relation("ExpenseCreator", fields: [createdById], references: [id])
  splits        ExpenseSplit[]
  parent        Expense?       @relation("RecurringExpenses", fields: [parentExpenseId], references: [id])
  children      Expense[]      @relation("RecurringExpenses")

  @@index([groupId])
  @@index([paidById])
  @@index([createdById])
  @@index([category])
  @@index([isRecurring])
  @@index([nextDueDate])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([groupId, createdAt])
}

model ExpenseSplit {
  id          String   @id @default(cuid())
  expenseId   String
  userId      String
  amount      Float
  percentage  Float?
  shares      Int?
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
  @@index([isPaid])
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id           String               @id @default(cuid())
  name         String
  logo         String?
  color        String?
  category     SubscriptionCategory @default(OTHER)
  monthlyCost  Float
  currency     String               @default("INR")
  billingCycle BillingCycle         @default(MONTHLY)
  renewalDate  DateTime
  autoRenew    Boolean              @default(true)
  isActive     Boolean              @default(true)
  usageScore   Int?
  lastUsed     DateTime?
  userId       String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupSubscriptions GroupSubscription[]

  @@index([userId])
  @@index([isActive])
  @@index([renewalDate])
  @@index([createdAt])
}

model GroupSubscription {
  id             String       @id @default(cuid())
  groupId        String
  subscriptionId String
  costPerPerson  Float        @default(0)
  createdAt      DateTime     @default(now())

  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([groupId, subscriptionId])
  @@index([groupId])
  @@index([subscriptionId])
}

// ─── Settlements ──────────────────────────────────────────────────────────────

model Settlement {
  id              String           @id @default(cuid())
  fromUserId      String
  toUserId        String
  amount          Float
  currency        String           @default("INR")
  status          SettlementStatus @default(PENDING)
  method          PaymentMethod?
  gateway         PaymentGateway?
  groupId         String?
  note            String?
  razorpayOrderId String?          @unique
  razorpayPaymentId String?        @unique
  stripePaymentId  String?         @unique
  idempotencyKey   String?         @unique
  providerEventId  String?
  transactionId   String?
  failureReason   String?
  partialAmount   Float?
  createdAt       DateTime         @default(now())
  completedAt     DateTime?
  updatedAt       DateTime         @updatedAt

  fromUser        User             @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser          User             @relation("SettlementTo", fields: [toUserId], references: [id])
  group           Group?           @relation(fields: [groupId], references: [id])
  payments        Payment[]

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@index([groupId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([stripePaymentId])
  @@index([providerEventId])
  @@index([createdAt])
}

model Payment {
  id                 String         @id @default(cuid())
  userId             String
  settlementId       String?
  gateway            PaymentGateway
  state              PaymentState   @default(CREATED)
  amount             Float
  currency           String         @default("INR")
  idempotencyKey     String         @unique
  providerOrderId    String?
  providerPaymentId  String?        @unique
  providerEventId    String?
  failureReason      String?
  metadata           Json?
  attemptedAt        DateTime?
  succeededAt        DateTime?
  failedAt           DateTime?
  refundedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user               User           @relation(fields: [userId], references: [id])
  settlement         Settlement?    @relation(fields: [settlementId], references: [id])

  @@index([userId])
  @@index([settlementId])
  @@index([state])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@index([providerEventId])
  @@index([createdAt])
}

model RiskEvent {
  id          String        @id @default(cuid())
  userId      String?
  type        RiskEventType
  level       RiskLevel
  score       Int
  ipAddress   String?
  fingerprintHash String?
  reason      String
  metadata    Json?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([level])
  @@index([score])
  @@index([createdAt])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id         String              @id @default(cuid())
  userId     String
  type       NotificationType
  channel    NotificationChannel @default(IN_APP)
  title      String
  body       String
  isRead     Boolean             @default(false)
  actionUrl  String?
  metadata   Json?
  status     NotificationStatus    @default(QUEUED)
  attempts   Int                   @default(0)
  lastError  String?
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model WebhookEvent {
  id              String        @id @default(cuid())
  provider        PaymentGateway
  eventId         String
  eventType       String
  status          WebhookStatus @default(RECEIVED)
  payload         Json
  signatureHash   String?
  error           String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  @@unique([provider, eventId])
  @@index([provider])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model Job {
  id          String    @id @default(cuid())
  name        String
  queue       String
  status      JobStatus @default(QUEUED)
  payload     Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([queue])
  @@index([status])
  @@index([runAfter])
  @@index([createdAt])
}

model ApiKey {
  id          String        @id @default(cuid())
  userId      String
  name        String
  prefix      String
  keyHash     String        @unique
  scopes      ApiKeyScope[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prefix])
  @@index([revokedAt])
  @@index([expiresAt])
}

model CustomerWebhook {
  id          String   @id @default(cuid())
  userId      String
  url         String
  secretHash  String
  events      String[]
  isActive    Boolean  @default(true)
  failureCount Int     @default(0)
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  rollout     Int      @default(0)
  rules       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}

model UsageEvent {
  id          String   @id @default(cuid())
  userId      String?
  event       String
  quantity    Int      @default(1)
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

model CompliancePolicy {
  id          String               @id @default(cuid())
  type        CompliancePolicyType
  version     String
  contentHash String
  effectiveAt DateTime
  createdAt   DateTime             @default(now())
  acceptances  ComplianceAcceptance[]

  @@unique([type, version])
  @@index([type])
  @@index([effectiveAt])
}

model ComplianceAcceptance {
  id          String   @id @default(cuid())
  userId      String
  policyId    String
  ipAddress   String?
  userAgent   String?
  acceptedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy      CompliancePolicy @relation(fields: [policyId], references: [id])

  @@unique([userId, policyId])
  @@index([userId])
  @@index([acceptedAt])
}

// ─── Gamification ─────────────────────────────────────────────────────────────

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String
  color       String
  rarity      BadgeRarity @default(COMMON)
  criteria    Json
  createdAt   DateTime    @default(now())

  userBadges  UserBadge[]
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeId     String
  unlockedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
}

// ─── SaaS Billing ─────────────────────────────────────────────────────────────

model Invoice {
  id                String   @id @default(cuid())
  userId            String
  amount            Float
  currency          String   @default("INR")
  plan              PlanType
  status            String   @default("PAID")
  razorpayPaymentId String?
  stripePaymentId   String?
  invoiceUrl        String?
  paidAt            DateTime?
  periodStart       DateTime
  periodEnd         DateTime
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([plan])
  @@index([razorpayPaymentId])
  @@index([stripePaymentId])
  @@index([createdAt])
}

model ImpersonationSession {
  id             String    @id @default(cuid())
  adminUserId    String
  targetUserId   String
  reason         String
  expiresAt      DateTime
  endedAt        DateTime?
  createdAt      DateTime  @default(now())

  adminUser      User      @relation("SupportAdmin", fields: [adminUserId], references: [id])
  targetUser     User      @relation("ImpersonatedUser", fields: [targetUserId], references: [id])

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([expiresAt])
  @@index([createdAt])
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  resource    String?
  resourceId  String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
